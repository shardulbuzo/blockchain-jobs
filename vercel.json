{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/superadmin007", "dest": "/api/admin/page" },
    { "src": "/superadmin007/(.*)", "dest": "/api/admin/page" },
    { "src": "/job/(.*)", "dest": "/api/content?type=job&id=$1" },
    { "src": "/(company|category|sector|country)/(.*)", "dest": "/404.html", "status": 404 },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
